# --- Auth ---
AUTH_USERNAME=your_username
# Bootstrap only: seeds the AUTH_USERNAME row in the users table on first start.
# Once that user has an active row, remove this line from .env and change the
# password in Settings instead. (While it is set, it is still accepted as a
# fallback login whenever AUTH_USERNAME has no active row.)
AUTH_PASSWORD_HASH=<bcrypt hash — generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())">
JWT_SECRET=<64-char hex string — generate with: python -c "import secrets; print(secrets.token_hex(32))">
JWT_EXPIRE_HOURS=24

# --- Encryption (for Plaid access tokens at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<fernet key>

# --- Plaid ---
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox   # sandbox | development | production

# --- AI (PDF statement import) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Coinbase (Advanced Trade API — CDP keys) ---
# Create at: coinbase.com → Developer Platform → API Keys → Create new key (read-only portfolio scope)
# Key name format: organizations/<org-id>/apiKeys/<key-id>
COINBASE_API_KEY_NAME=organizations/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apiKeys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Paste the EC private key exactly as shown — the \n characters are intentional
COINBASE_API_KEY_PRIVATE=-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END EC PRIVATE KEY-----\n

# --- Web Search (Tavily) ---
# Powers the Dashboard news feed.
# Free tier: 1,000 searches/month. Sign up at app.tavily.com
TAVILY_API_KEY=tvly-...

# --- Market rates (FRED) ---
# Powers the Dashboard rates panel. Free key at fred.stlouisfed.org
FRED_API_KEY=your_fred_api_key

# --- Web Push (VAPID) ---
# Generate the pair with: python scripts/generate_vapid_keys.py
# The private key is one line with literal \n, like the Coinbase key above.
VAPID_PUBLIC_KEY=<base64url public key, 87 chars>
VAPID_PRIVATE_KEY_PEM=-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END EC PRIVATE KEY-----
VAPID_EMAIL=mailto:you@example.com

# --- Backups (Litestream -> Cloudflare R2) ---
# Read by deploy/start.sh and deploy/restore.sh, not by the app.
# Create an R2 API token with Object Read & Write on the backup bucket only.
LITESTREAM_ACCESS_KEY_ID=your_r2_access_key_id
LITESTREAM_SECRET_ACCESS_KEY=your_r2_secret_access_key
